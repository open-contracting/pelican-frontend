{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "entry": ["src/scss/main.scss"],
  "ignore": [
    "src/schema.d.ts" // generated by openapi-typescript
  ],
  "ignoreDependencies": [
    "bootstrap", // imported in src/scss/main.scss (knip doesn't resolve package SCSS @imports)
    "openapi-typescript", // run by hand, to regenerate src/schema.d.ts
    "vue-tsc" // run by CI
  ]
}
