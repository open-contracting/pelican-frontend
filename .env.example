# Copy this file to .env, which git ignores, and fill in the values you need. Load it with:
#
#     uv run --env-file .env manage.py runserver

# Pelican backend's database, which this project reads.
PELICAN_BACKEND_DATABASE_URL=postgresql://USER:PASSWORD@HOST/pelican_backend

# Kingfisher Process' database, which this project reads.
KINGFISHER_PROCESS_DATABASE_URL=postgresql://USER:PASSWORD@HOST/kingfisher_process

# RabbitMQ, to which this project publishes.
RABBIT_URL=amqp://127.0.0.1
RABBIT_EXCHANGE_NAME=pelican_development

# HTTP Basic credentials for the production frontend, to compare a branch against it.
PELICAN_PRODUCTION_URL=https://USER:PASSWORD@pelican.open-contracting.org
