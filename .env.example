# Copy this file to .env, which git ignores, and fill in the values you need. Load it with:
#
#     uv run --env-file .env manage.py runserver

# Pelican backend's database, which this project reads.
PELICAN_BACKEND_DATABASE_URL=postgresql://USER:PASSWORD@HOST/pelican_backend

# HTTP Basic credentials for the production frontend, to compare a branch against it.
PELICAN_PRODUCTION_URL=https://USER:PASSWORD@pelican.open-contracting.org

# Leave the rest unset when the connection string above points at production. DATABASE_URL is this
# project's own database, so an exported report is recorded locally. RABBIT_URL and
# RABBIT_EXCHANGE_NAME are read only when publishing, which only the endpoints named in
# docs/contributing/compare-to-production.rst do, and an unset broker is a local one.
# KINGFISHER_PROCESS_DATABASE_URL is read only by DatasetViewSet.create, which no page reaches.
