{
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 119,
    // reports.json is written by tests/fixtures/build_reports.py, which expands every array, so formatting it here
    // would make each rebuild dirty the file.
    "includes": ["**", "!release-schema.json", "!tests/fixtures/reports.json"]
  },
  "overrides": [
    {
      "includes": ["**/*.vue"],
      "linter": {
        "rules": {
          "correctness": {
            // A component that only a template renders, and a value that only a template reads, are both used.
            "noUnusedImports": "off",
            "noUnusedVariables": "off"
          },
          "style": {
            // A component that a template renders, and a script only names as a type, is not a type-only import.
            "useImportType": "off"
          }
        }
      }
    }
  ]
}
